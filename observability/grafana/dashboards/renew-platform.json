    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "Log lines per second, grouped by service.",
      "fieldConfig": {"defaults": {"unit": "logs/sec", "color": {"mode": "palette-classic"}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "editorMode": "code", "expr": "sum by (service) (rate({job=\"renew-platform\", service=~\"$service\"}[$__interval]))", "queryType": "range", "refId": "A"}],
      "title": "Log activity by service",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "Completed Celery task executions by task and status, over the selected time range.",
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "editorMode": "code", "expr": "sum by (task_name, task_state) (count_over_time({job=\"renew-platform\", service=\"celery-worker\", task_name=~\"$task_name\", event_type=\"celery_task_finished\"}[$__interval]))", "queryType": "range", "refId": "A"}],
      "title": "Task completions by state",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
